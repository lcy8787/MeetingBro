# ============================================================
# MeetingBro Configuration Template
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.
# ============================================================

# LLM / Summary / Translation (optional)
# Supports any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Mistral, Ollama, etc.)
# If left empty, the transcript is still available but no model summary is published.
MEETINGBRO_LLM_API_KEY=
MEETINGBRO_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Example only: install and select a model that fits your device.
MEETINGBRO_LLM_MODEL=qwen2.5:3b
# Timeout, output budget and safe transient retry policy (one retry by default).
MEETINGBRO_LLM_TIMEOUT_SECONDS=45
# 0 = provider default (12000 on OpenRouter, 7200 elsewhere).
MEETINGBRO_LLM_MAX_OUTPUT_TOKENS=0
MEETINGBRO_LLM_MAX_ATTEMPTS=2
MEETINGBRO_LLM_RETRY_BACKOFF_SECONDS=0.5

# ── Qwen3-ASR (the only speech engine) ───────────────────────
# 0.6B | 1.7B. Apple Silicon uses MLX; other platforms use qwen-asr.
MEETINGBRO_QWEN3_MODEL_SIZE=0.6B
# Optional explicit local path; omit to use models/Qwen3-ASR-<size>-4bit on MLX.
# MEETINGBRO_QWEN3_MLX_MODEL=/absolute/path/to/Qwen3-ASR-0.6B-4bit
# MEETINGBRO_QWEN3_MODEL=/absolute/path/to/Qwen3-ASR-0.6B
# OpenRouter summaries (set these instead of the local Ollama values above):
# MEETINGBRO_LLM_BASE_URL=https://openrouter.ai/api/v1
# MEETINGBRO_LLM_API_KEY=your-openrouter-key
# MEETINGBRO_LLM_MODEL=deepseek/deepseek-v4.1-flash

# ── Audio chunking ───────────────────────────────────────────
MEETINGBRO_CHUNK_SECONDS=0.5
MEETINGBRO_ASR_ACCUM_SECONDS=2.0
MEETINGBRO_SILENCE_RMS_THRESHOLD=0.001
MEETINGBRO_ASR_OVERLAP_SECONDS=0.0

# ── Voice Activity Detection (VAD) ───────────────────────────
MEETINGBRO_PRE_VAD_ENABLED=true
MEETINGBRO_PRE_VAD_TRAILING_SILENCE_SECONDS=0.50
MEETINGBRO_PRE_VAD_MAX_SEGMENT_SECONDS=8

# ── Live Translation ─────────────────────────────────────────
MEETINGBRO_TRANSLATION_EXECUTOR_WORKERS=2
MEETINGBRO_LIVE_TRANSLATION_BACKFILL_LIMIT=20
MEETINGBRO_LIVE_TRANSLATION_MAX_PENDING=12

# ── Segment quality filters ──────────────────────────────────
MEETINGBRO_SUSPICIOUS_SEGMENT_NO_SPEECH_PROB=0.6
MEETINGBRO_SUSPICIOUS_SEGMENT_AVG_LOGPROB=-0.9
MEETINGBRO_SUSPICIOUS_SEGMENT_COMPRESSION_RATIO=2.1

# ── Audio denoising (experimental) ───────────────────────────
MEETINGBRO_DENOISE_ENABLED=false
MEETINGBRO_DENOISE_STRENGTH=1.1
MEETINGBRO_DENOISE_NOISE_UPDATE_RMS_THRESHOLD=0.02

# ── Speaker diarization ──────────────────────────────────────
MEETINGBRO_ENABLE_DIARIZATION=false
# MEETINGBRO_VOCABULARY_HINT=OpenAI, Anthropic, Teams, Zoom, BBB

# ── Audio conditioning ───────────────────────────────────────
MEETINGBRO_AUDIO_CONDITIONING_ENABLED=true
MEETINGBRO_AUDIO_CONDITIONING_TARGET_RMS=0.035
MEETINGBRO_AUDIO_CONDITIONING_MIN_RMS=0.003
MEETINGBRO_AUDIO_CONDITIONING_MAX_GAIN=2.5
MEETINGBRO_AUDIO_CONDITIONING_PEAK_LIMIT=0.98
MEETINGBRO_PRE_VAD_CONDITIONING_ENABLED=true
MEETINGBRO_PRE_VAD_CONDITIONING_TARGET_RMS=0.03
MEETINGBRO_PRE_VAD_CONDITIONING_MIN_RMS=0.001
MEETINGBRO_PRE_VAD_CONDITIONING_MAX_GAIN=4.0
MEETINGBRO_PRE_VAD_THRESHOLD=0.38
MEETINGBRO_PRE_VAD_ENERGY_RMS_THRESHOLD=0.005

# ── Language detection ───────────────────────────────────────
# Set to true to lock to a single language (faster, less drift)
MEETINGBRO_LANGUAGE_LOCK_ENABLED=false
MEETINGBRO_ASR_RETRY_ENABLED=true

# ── Realtime safeguard ───────────────────────────────────────
MEETINGBRO_ASR_SAFEGUARD_ENABLED=true
MEETINGBRO_ASR_SAFEGUARD_RTF_THRESHOLD=0.9
MEETINGBRO_ASR_SAFEGUARD_COOLDOWN_WINDOWS=5
MEETINGBRO_LIVE_TRANSLATION_SAFEGUARD_MAX_PENDING=4

# ── Weak voice rescue ────────────────────────────────────────
MEETINGBRO_WEAK_SPEECH_RESCUE_ENABLED=true
MEETINGBRO_WEAK_SPEECH_RESCUE_RMS_MIN=0.0008
MEETINGBRO_WEAK_SPEECH_RESCUE_RMS_MAX=0.02
MEETINGBRO_WEAK_SPEECH_RESCUE_WINDOW_SECONDS=6
MEETINGBRO_WEAK_SPEECH_RESCUE_COOLDOWN_SECONDS=8

# ── Runtime profile ──────────────────────────────────────────
# Options: balanced | robust | fast | low_latency
MEETINGBRO_RUNTIME_PROFILE=balanced
# Host/port the backend binds to. The desktop app sets MEETINGBRO_PORT
# automatically when it launches the backend; set these only for manual runs.
MEETINGBRO_HOST=127.0.0.1
MEETINGBRO_PORT=8765

# ── Speaker diarization (opt-in, off by default) ─────────────
# Label who-spoke-when. neural = sherpa-onnx speaker embeddings (recommended,
# needs a model under models/speaker-embedding/); energy = dependency-free
# heuristic fallback. Falls back to energy if the neural model is missing.
# Download the default neural model (~28 MB) once:
#   curl -fL -o models/speaker-embedding/3dspeaker_campplus_sv_zh-cn_16k-common.onnx \
#     https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
MEETINGBRO_DIARIZATION_ENABLED=false
MEETINGBRO_DIARIZATION_BACKEND=neural
# MEETINGBRO_DIARIZATION_MODEL=models/speaker-embedding/3dspeaker_campplus_sv_zh-cn_16k-common.onnx
MEETINGBRO_DIARIZATION_THRESHOLD=0.5
MEETINGBRO_DIARIZATION_NUM_THREADS=1
MEETINGBRO_DIARIZATION_PROVIDER=cpu

# ── Preview ASR (fast subtitles) ─────────────────────────────
MEETINGBRO_PREVIEW_ASR_EXECUTOR_WORKERS=1
MEETINGBRO_AUDIO_INPUT_QUEUE_MAX_SECONDS=10
MEETINGBRO_AUDIO_INPUT_QUEUE_WARNING_SECONDS=3
MEETINGBRO_FAST_PREVIEW_WINDOW_SECONDS=2.0
MEETINGBRO_FAST_PREVIEW_INTERVAL_SECONDS=0.7

# ── Early flush / silence commit ─────────────────────────────
MEETINGBRO_ASR_EARLY_FLUSH_ENABLED=true
MEETINGBRO_ASR_EARLY_FLUSH_MIN_SECONDS=1.0
MEETINGBRO_SILENCE_COMMIT_MIN_CONFIDENCE=0.78
MEETINGBRO_SILENCE_COMMIT_MIN_DURATION_SECONDS=0.70
MEETINGBRO_PRE_VAD_ADAPTIVE_FAST_TRAILING_SILENCE_SECONDS=0.30
MEETINGBRO_FAST_PREVIEW_MAX_BACKLOG_SECONDS=2.0
MEETINGBRO_FAST_PREVIEW_MAX_ASR_RTF=1.2
MEETINGBRO_FAST_PREVIEW_MIN_RMS=0.006

# Summary requests are controlled by the summary page: manual generation or
# opt-in periodic updates (first 5 minutes, then 10 minutes after first success).
# Stopping recording separately generates one final report after saving transcript.
# Legacy live/final summary environment switches are no longer used by the UI.
# Pause new LLM work if OS memory availability is below this percentage or
# captured audio waiting for ASR exceeds this many seconds. Existing inference
# is allowed to finish; tune only after measuring your own hardware.
MEETINGBRO_LLM_MIN_MEMORY_FREE_PERCENT=10
MEETINGBRO_LLM_ASR_BACKLOG_SECONDS=0.5
# realtime | balanced | post_recording (resource coordination; summary triggers use the summary page)
MEETINGBRO_LLM_RESOURCE_MODE=balanced
